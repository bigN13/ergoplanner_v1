    "next": "15.5.3",
    "rc-dock": "^4.0.0-alpha.2",
    "react": "19.1.0",
    "react-colorful": "^5.6.1",
    "react-dom": "19.1.0",
    "react-draggable": "^4.5.0",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.63.0",
    "react-hotkeys-hook": "^5.1.0",
    "react-resizable": "^3.0.5",
